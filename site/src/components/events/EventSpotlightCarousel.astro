---
import type { Event } from "../../types/event";

interface Props {
  events: Event[];
}

const { events } = Astro.props;
const featuredEvents = events.filter((event) => event.featured);

function formatMonth(dateString: string) {
  const date = new Date(dateString);
  return date.toLocaleString("pt-BR", { month: "short" }).toUpperCase();
}

function formatDay(dateString: string) {
  const date = new Date(dateString);
  return String(date.getDate()).padStart(2, "0");
}
---

<section class="events-spotlight">
  <div class="events-intro-card">
    <span class="events-kicker">Destaque</span>
    <h1>Os próximos grandes encontros</h1>
    <p>
      Fique por dentro das datas, locais e informações dos eventos mais
      relevantes da missão.
    </p>
  </div>

  <div class="events-spotlight__carousel">
    <div class="events-feature-track">
      {
        featuredEvents.map((event) => (
          <a href={`/eventos/${event.slug}`} class="event-feature-card">
            <div class="event-feature-card__image">
              <img src={event.cover} alt={event.title} />
            </div>

            <div class="event-feature-card__body">
              <div class="event-feature-card__date">
                <span>{formatMonth(event.startDate)}</span>
                <strong>{formatDay(event.startDate)}</strong>
              </div>

              <div>
                <span class="event-feature-card__tag">
                  {event.label ?? event.location.name}
                </span>
                <h2>{event.title}</h2>
                <p>{event.summary}</p>
                <span class="event-feature-card__location">
                  <i class="fa-solid fa-location-dot" />
                  {event.location.city} - {event.location.state}
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
