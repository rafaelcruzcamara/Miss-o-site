---
interface EventItem {
  month: string;
  day: string;
  location: string;
  title: string;
  description: string;
  image: string;
  href: string;
  tag: string;
}

interface Props {
  events: EventItem[];
}

const { events } = Astro.props;

const nearestEvent = events[0];
const nextEvents = events.slice(1, 3);
---

<section class="nearest-event-section">

  <div class="nearest-event-grid">
    <a href={nearestEvent.href} class="nearest-event-card">
      <div class="nearest-event-card__content">
        <span class="nearest-event-card__tag">{nearestEvent.tag}</span>

        <div>
          <h2>{nearestEvent.title}</h2>
          <p>{nearestEvent.description}</p>
        </div>

        <div class="nearest-event-card__footer">
          <span>
            <i class="fa-solid fa-location-dot"></i>
            {nearestEvent.location}
          </span>

          <strong>
            Ver detalhes
            <i class="fa-solid fa-arrow-right"></i>
          </strong>
        </div>
      </div>

      <div class="nearest-event-card__image">
        <img src={nearestEvent.image} alt={nearestEvent.title} />

        <div class="nearest-event-date">
          <span>{nearestEvent.month}</span>
          <strong>{nearestEvent.day}</strong>
        </div>
      </div>
    </a>

    <aside class="next-events-card">
      <div class="next-events-card__header">
        <span class="events-kicker">Eventos</span>
        <h3>Próximos</h3>
      </div>

      <div class="next-events-list">
        {
          nextEvents.map((event) => (
            <a href={event.href} class="next-event-item">
              <div class="next-event-date">
                <span>{event.month}</span>
                <strong>{event.day}</strong>
              </div>

              <div>
                <h4>{event.title}</h4>
                <p>{event.location}</p>
              </div>

              <i class="fa-solid fa-arrow-right"></i>
            </a>
          ))
        }
      </div>
    </aside>
  </div>
</section>
