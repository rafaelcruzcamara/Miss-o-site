---
import type { Event } from "../../types/event";

interface Props {
  events: Event[];
}

const { events } = Astro.props;

const calendarEvents = events.map((event) => {
  const date = new Date(event.startDate);
  return {
    day: String(date.getDate()),
    title: event.title,
    type: event.featured ? "yellow" : "dark",
  };
});

const days = Array.from({ length: 35 }, (_, index) => {
  const day = String(index + 1);
  const event = calendarEvents.find((item) => item.day === day);

  return {
    day,
    event,
  };
});
---

<section class="events-calendar-section">
  <div class="events-section-heading">
    <span class="events-kicker">Calendário</span>
    <h2>Agenda do mês</h2>
    <p>
      Visualize os próximos encontros e acompanhe as datas principais da missão.
    </p>
  </div>

  <div class="events-calendar">
    <div class="events-calendar__top">
      <div>
        <span>2026</span>
        <h3>Janeiro</h3>
      </div>

      <div class="events-calendar__legend">
        <span
          ><i class="legend-dot legend-dot--yellow"></i> Evento principal</span
        >
        <span><i class="legend-dot legend-dot--dark"></i> Encontro</span>
      </div>
    </div>

    <div class="events-calendar__weekdays">
      <span>Dom</span>
      <span>Seg</span>
      <span>Ter</span>
      <span>Qua</span>
      <span>Qui</span>
      <span>Sex</span>
      <span>Sáb</span>
    </div>

    <div class="events-calendar__grid">
      {
        days.map((item) => (
          <div
            class={`calendar-day ${item.event ? "calendar-day--active" : ""}`}
          >
            <strong>{item.day}</strong>

            {item.event && (
              <span class={`calendar-event calendar-event--${item.event.type}`}>
                {item.event.title}
              </span>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
