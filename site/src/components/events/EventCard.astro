---
interface Props {
  title: string;
  description: string;
  image: string;
  href: string;
  label: string;
}

const { title, image, href, label } = Astro.props;
---

<a href={href} class="event-card">
  <div class="event-card__image">
    <img src={image} alt={title} />
  </div>

  <div class="event-card__content">
    <span>{label}</span>

    <div>
      <h3>{title}</h3>
      <p>Ver detalhes</p>
    </div>

    <i class="fa-solid fa-arrow-right"></i>
  </div>
</a>
