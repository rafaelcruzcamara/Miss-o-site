---
import "../styles/components/header.css";

interface Props {
  active?: "index" | "fundacao" | "caminho" | "sobre" | "eventos" | "socio";
  variant?: "default" | "glass-dark";
}

const { active, variant = "default" } = Astro.props;

const navClass =
  variant === "glass-dark"
    ? "mises-nav mises-nav--glass-dark"
    : "mises-nav";

const linkClass = (key: string) =>
  active === key ? "mises-nav__link is-active" : "mises-nav__link";

const ctaClass =
  active === "socio" ? "mises-nav__cta is-active" : "mises-nav__cta";
---

<nav class={navClass} data-mises-nav>
  <div class="mises-nav__links mises-nav__links--left">
    <a href="index.html" class={linkClass("index")}>Início</a>
    <a href="fundacao.html" class={linkClass("fundacao")}>Fundação</a>
    <a href="caminho.html" class={linkClass("caminho")}>Caminho de São José</a>
  </div>

  <a class="mises-nav__brand" href="index.html" aria-label="Ir para a página inicial">
    <img
      src="legacy/img/download-removebg-preview.png"
      alt="Logo Missão Servos"
    />
  </a>

  <div class="mises-nav__links mises-nav__links--right">
    <a href="sobre.html" class={linkClass("sobre")}>Quem Somos</a>
    <a href="eventos.html" class={linkClass("eventos")}>Agenda e Eventos</a>
    <a href="socio.html" class={ctaClass}>Ajude a Obra</a>
  </div>

  <button
    class="mises-nav__toggle"
    type="button"
    data-mises-nav-toggle
    aria-label="Abrir menu"
    aria-expanded="false"
  >
    <i class="fa-solid fa-bars"></i>
  </button>
</nav>

<script is:inline>
  document.addEventListener("click", (event) => {
    const toggle = event.target.closest("[data-mises-nav-toggle]");
    if (!toggle) return;

    const nav = toggle.closest("[data-mises-nav]");
    if (!nav) return;

    const isOpen = nav.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(isOpen));
  });
</script>
