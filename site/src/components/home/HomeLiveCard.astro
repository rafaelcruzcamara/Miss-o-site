---
interface Props {
  image: string;
  alt: string;
  tag: string;
  title: string;
  href: string;
}

const { image, alt, tag, title, href } = Astro.props;
---

<article class="card live-card">
  <img src={image} class="bg-img" alt={alt} />

  <div class="play-overlay">
    <div class="play-btn">
      <i class="fa-solid fa-play"></i>
    </div>
  </div>

  <div class="live-info">
    <span class="live-tag">{tag}</span>
    <h4>{title}</h4>
    <a href={href} target="_blank" rel="noopener noreferrer" class="home-hidden-link">
      Ver mais
    </a>
  </div>
</article>
