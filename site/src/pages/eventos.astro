---
import SiteLayout from "../layouts/SiteLayout.astro";
import EventSpotlightCarousel from "../components/events/EventSpotlightCarousel.astro";
import EventCard from "../components/events/EventCard.astro";
import EventsCalendar from "../components/events/EventsCalendar.astro";

import {
  featuredEvents,
  eventsList,
  calendarEvents,
} from "../data/events";

import "../styles/pages/eventos.css";
---

<SiteLayout title="Agenda e Eventos | Missão Servos" active="eventos">
  <main class="events-page">
    <EventSpotlightCarousel events={featuredEvents} />

    <section class="events-list-section">
      <div class="events-section-heading">
        <span class="events-kicker">Participe</span>
        <h2>Eventos e experiências</h2>
        <p>
          Escolha um evento para conhecer melhor, ver detalhes e acompanhar as
          próximas informações.
        </p>
      </div>

      <div class="events-grid">
        {eventsList.map((event) => <EventCard {...event} />)}
      </div>
    </section>

    <EventsCalendar events={calendarEvents} />
  </main>
</SiteLayout>
