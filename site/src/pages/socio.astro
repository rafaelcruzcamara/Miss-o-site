---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/pages/socio.css";
---

<SiteLayout
  title="Ajude a Obra | Missão Servos"
  active="socio"
>
<div class="page-wrapper">
        
        

        <header class="socio-header ">
            <span class="label-tiny ">Sustente a Obra</span>
            <h1 class="headline-donation animate-on-scroll">Seu <strong style="color: var(--yellow);">sim</strong> sustenta<br>nossa missão.</h1>
            <p class="donation-text">
                Ao se tornar um benfeitor, você assume um compromisso de amor. A missão se faz com os pés dos que partem, com a oração dos que ficam e as mãos dos que contribuem.
            </p>
        </header>

        <div class="quick-action-grid animate-on-scroll delay-1">
            
            <div class="impact-img-box carousel-container">
                <img src="legacy/img/socios7.jpg" class="impact-img active" alt="Missão 1">
                <img src="legacy/img/socio luana.jpg" class="impact-img" alt="Missão 2">
                <img src="legacy/img/socio.jpg" class="impact-img" alt="Missão 3">
                <img src="legacy/img/socio3.jpg" class="impact-img" alt="Missão 4">
                <img src="legacy/img/socio5.jpg" class="impact-img" alt="Missão 5">
                
                <div class="overlay-caption">
                    <i class="fa-solid fa-heart"></i> Nossos Frutos
                </div>
            </div>

            <div class="pix-card-hero">
                <div class="pix-header">
                    <i class="fa-brands fa-pix"></i>
                    <h3>Doação Rápida via PIX</h3>
                </div>
                
                <div class="pix-content">
                    <p class="pix-desc">Use o QR Code ou copie a chave abaixo para contribuir com qualquer valor.</p>
                    
                    <div class="qr-code-wrapper">
                         <img src="legacy/img/qrcode.jpg" alt="QR Code Pix" class="qr-img">
                    </div>

                    <div class="key-wrapper">
                        <span class="key-label">Chave CNPJ</span>
                        <div class="key-value" id="pixKey">20.763.459/0001-54</div>
                        <button class="btn-copy-hero" onclick="copyPix()">
                            <i class="fa-regular fa-copy"></i> Copiar Chave
                        </button>
                    </div>
                </div>
                <div class="pix-footer-hero">Favorecido: Missão Servos do Espírito Santo</div>
            </div>

        </div>
<div class="donation-card-wide">
        <form action="https://formsubmit.co/ins.servos@gmail.com" method="POST" class="smart-form">

    <input type="hidden" name="_next" value="https://servosdoespiritosanto.com/obrigado.html">
    <input type="hidden" name="_subject" value="Novo Benfeitor Cadastrado!">
    <input type="hidden" name="_template" value="table">

    <div class="form-group">
        <label>Nome Completo *</label>
        <div class="double-input">
            <input type="text" name="nome" class="form-input" placeholder="Primeiro Nome" required>
            <input type="text" name="sobrenome" class="form-input" placeholder="Último Nome" required>
        </div>
    </div>

    <div class="form-group">
        <label>WhatsApp</label>
        <input type="tel" name="whatsapp" class="form-input" placeholder="(00) 90000-0000" onkeyup="mascaraTel(this)">
    </div>

    <div class="form-group">
        <label>E-mail *</label>
        <input type="email" name="email" class="form-input" placeholder="seu@email.com" required>
    </div>

    <div class="form-group" style="margin-top: 20px;">
        <label>Mensagem (Opcional)</label>
        <textarea name="mensagem" class="form-input" rows="3" placeholder="Gostaria de dizer algo?"></textarea>
    </div>

    <button type="submit" class="btn-submit-wide">
        Concluir Cadastro
    </button>

</form>
</div>
    </div>

    


    <script is:inline>
        async function copyPix() {
            const pixKey = document.getElementById('pixKey')?.innerText;
            if (!pixKey || !navigator.clipboard?.writeText) {
                alert("Não foi possível copiar a chave PIX. Copie-a manualmente.");
                return;
            }

            try {
                await navigator.clipboard.writeText(pixKey);
                alert("Chave PIX copiada!");
            } catch {
                alert("Não foi possível copiar a chave PIX. Copie-a manualmente.");
            }
        }
        
        // Animação Scroll
        const observer = new IntersectionObserver(entries => {
            entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('in-view')});
        });
        document.querySelectorAll('.animate-on-scroll').forEach(el => observer.observe(el));
        
        // Carrossel Automático
        const carouselImages = document.querySelectorAll('.carousel-container .impact-img');
        let currentImgIndex = 0;
        if (carouselImages.length > 0) {
            setInterval(() => {
                carouselImages[currentImgIndex].classList.remove('active');
                currentImgIndex = (currentImgIndex + 1) % carouselImages.length;
                carouselImages[currentImgIndex].classList.add('active');
            }, 3000); 
        }

    // Telefone
    function mascaraTel(input) {
        let v = input.value.replace(/\D/g, "");
        v = v.replace(/^(\d{2})(\d)/g, "($1) $2");
        v = v.replace(/(\d)(\d{4})$/, "$1-$2");
        input.value = v.substring(0, 15);
    }

    </script>
</SiteLayout>
