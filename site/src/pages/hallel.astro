---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/pages/hallel.css";
---

<SiteLayout
  title="Hallel 2026 | Missão Servos"
  showHeader={false}
  showFooter={false}
>
  <a href="index.html" class="hallel-back-button" aria-label="Voltar para a página inicial">
    <i class="fa-solid fa-arrow-left"></i>
  </a>

  <div class="hallel-page">
    <header class="urban-hero">
      <div class="hero-bg"></div>

      <div class="tape-strip tape-bg">
        <span>HALLEL 2026 /// HALLEL 2026 /// HALLEL 2026 ///</span>
      </div>

      <div class="hero-content">
        <h1 class="glitch-title" data-text="HALLEL">HALLEL</h1>
        <h2 class="outline-subtitle">O RESGATE</h2>

        <p class="hero-desc">
          Três dias de acampamento, som no talo e <br />
          uma experiência que vai explodir sua mente.
        </p>

        <a href="#galeria" class="btn-urban">
          VER A VIBE <i class="fa-solid fa-arrow-down"></i>
        </a>
      </div>

      <div class="tape-strip tape-cross">
        <span>JUVENTUDE SENTINELA /// OUSADIA /// FOGO ///</span>
      </div>
    </header>

    <div class="marquee-container">
      <div class="marquee-content">
        MÚSICA • ADORAÇÃO • CAMPING • AMIZADE • FOGO DO ESPÍRITO •
        MÚSICA • ADORAÇÃO • CAMPING • AMIZADE • FOGO DO ESPÍRITO •
        MÚSICA • ADORAÇÃO • CAMPING • AMIZADE • FOGO DO ESPÍRITO •
        MÚSICA • ADORAÇÃO • CAMPING • AMIZADE • FOGO DO ESPÍRITO •
        MÚSICA • ADORAÇÃO • CAMPING • AMIZADE • FOGO DO ESPÍRITO •
      </div>
    </div>

    <section class="mixed-gallery" id="galeria">
      <div class="gallery-header animate-on-scroll">
        <h2 class="gallery-title">
          MOMENTOS <span>REAIS</span>
        </h2>
        <p>Se liga no que rola quando a gente se encontra.</p>
      </div>

      <div class="bento-grid animate-on-scroll">
        <div class="media-card big">
          <img src="legacy/img/hallel.jpg" alt="Hallel Palco" />
          <div class="card-overlay">
            <span class="label-tape">youth 2025</span>
          </div>
        </div>

        <div class="media-card tall video-card">
          <video src="legacy/hallel/lual.mp4" muted loop autoplay playsinline></video>
          <div class="card-overlay">
            <span class="label-tape">Lual</span>
          </div>
        </div>

        <div class="media-card">
          <img src="legacy/hallel/abraço.jpeg" alt="Galera" />
        </div>

        <div class="media-card video-card">
          <video
            src="legacy/hallel/WhatsApp Video 2026-01-10 at 5.36.56 PM.mp4"
            muted
            loop
            autoplay
            playsinline
          ></video>
        </div>

        <div class="media-card wide">
          <img src="legacy/hallel/felipe poster.png" alt="Show Luzes" />
          <div class="card-overlay">
            <span class="label-tape">Adoração e alegria</span>
          </div>
        </div>

        <div class="media-card">
          <img src="legacy/hallel/abarço2.jpeg" alt="Oração" />
        </div>

        <div class="media-card video-card">
          <img src="legacy/hallel/cruz.jpeg" alt="Cruz" />
        </div>
      </div>

      <div class="cta-section animate-on-scroll">
        <div class="tape-box">
          <h2>VAI FICAR DE FORA?</h2>
          <a href="inscricao.html?id=hallel" class="btn-urban btn-big">
            GARANTIR MINHA VAGA
          </a>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add("in-view");
      });
    });

    document
      .querySelectorAll(".animate-on-scroll")
      .forEach((element) => observer.observe(element));
  </script>
</SiteLayout>

